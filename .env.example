# The public URL of your website (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ── Event inquiry delivery (server-side only; never prefix with NEXT_PUBLIC_) ──
# Option A: email via Resend (https://resend.com), free tier is enough.
#   Sign up to Resend WITH imenaeventproductionltd@gmail.com, create an API key, paste it here.
RESEND_API_KEY=
# Where inquiries go (defaults to the email in config/site.ts if left empty).
INQUIRY_TO_EMAIL=imenaeventproductionltd@gmail.com
# Leave EMPTY unless you have verified your own domain in Resend
# (then e.g. IMENA Website <inquiries@yourdomain.rw>). While empty, Resend's test
# sender is used, which only delivers to the email the Resend account belongs to.
INQUIRY_FROM_EMAIL=

# Option B: any webhook / form service that accepts JSON POSTs (Formspree, Make, Zapier…)
INQUIRY_WEBHOOK_URL=
